{
  "name": "pokebot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de Discord inspirado en el estilo de escritura de una persona real.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/aplicar-esquema.ts"
  },
  "dependencies": {
    "@google/genai": "latest",
    "discord.js": "latest",
    "dotenv": "latest",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "tsx": "latest",
    "typescript": "latest"
  }
}
